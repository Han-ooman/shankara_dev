{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2",
      "config": {
        "includePaths": ["assets/**", "format_bast/**", "manifest.json", "sw.js"]
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/api/index.php" },
    { "src": "/format_bast/(.*)", "dest": "/api/index.php" },
    { "src": "/manifest.json", "dest": "/api/index.php" },
    { "src": "/sw.js", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}